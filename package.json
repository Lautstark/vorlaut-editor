{
  "name": "vorlaut-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Board editor for the Lautstark AAC tools: five-key talker boards and tablet boards, exported as files.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "svelte-check --tsconfig ./tsconfig.app.json --threshold error && tsc -b tsconfig.node.json tsconfig.e2e.json tsconfig.test.json --force",
    "preflight": "node tools/installcheck.mjs",
    "test": "node tools/installcheck.mjs && vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tools/installcheck.mjs && BASE_PATH=/ npm run build && playwright test",
    "test:e2e:only": "playwright test",
    "build:pages": "BASE_PATH=/ npm run build"
  },
  "dependencies": {
    "@diffusionstudio/piper-wasm": "^1.0.0",
    "@lautstark/bildquelle": "github:Lautstark/bildquelle#v2.4.0",
    "@lautstark/design": "github:Lautstark/design#v1.40.0",
    "@lautstark/sicherung": "github:Lautstark/sicherung#v1.17.1",
    "@lautstark/stimmquelle": "github:Lautstark/stimmquelle#v2.12.1",
    "@lautstark/werkzeuge": "github:Lautstark/werkzeuge#v1.3.0",
    "idb": "^8.0.3",
    "onnxruntime-web": "1.18.0"
  },
  "devDependencies": {
    "@lautstark/toolchain": "github:Lautstark/toolchain#v1.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^22.10.0",
    "fake-indexeddb": "^6.0.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6"
  }
}
