{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["vite/client"],

    "strict": true,
    /* The port from JavaScript was a rename, not a rewrite: the modules came
       across unchanged so that the frozen references still measure the same
       code. Implicit any is what that costs, and it is the one strictness flag
       turned off rather than the whole of `strict` - strictNullChecks, which is
       where the real bugs are, stays on. Turn this on file by file as the
       signatures get written. */
    "noImplicitAny": false,
    "strictNullChecks": false,

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  },
  /* One program's worth of source, and that is what the split left.

     `loader` stood here too - the page that takes an exported file to a talker
     - along with `loader/tools/cable.js`, which needed allowJs above because
     it is JavaScript on purpose. adr/0012 took both to
     Lautstark/vorlaut-diy-talker, where the firmware they are held against
     already was. `third_party/` is deliberately absent and must stay absent:
     it holds a whole checkout of that repository for device/fixtures/, and a
     compiler that reads code out of it is the one edit that would quietly
     reinstate the dependency adr/0011 removed. */
  "include": ["src"]
}
